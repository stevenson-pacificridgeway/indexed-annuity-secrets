# Caddy config for Railway. Railway injects $PORT at runtime.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# One canonical address: send bare domain to www
	@nonwww host indexedannuitysecrets.com
	redir @nonwww https://www.indexedannuitysecrets.com{uri} permanent

	# Old .html addresses -> clean URLs (keeps one version of each page in Google)
	@indexhtml path_regexp idx ^(.*/)index\.html$
	redir @indexhtml {re.idx.1} permanent
	@html {
		path_regexp htm ^(.+)\.html$
		not path */index.html
	}
	redir @html {re.htm.1} permanent

	# Vanity redirect: /active-resources -> the Resources page
	redir /active-resources /resources permanent

	# Clean URLs: /contact -> contact.html if present
	try_files {path} {path}.html {path}/index.html

	file_server

	# Cache static assets aggressively; HTML stays fresh.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
	header *.html Cache-Control "public, max-age=300"
}
